WorldInfo {
  info [
    "Pioneer 3-AT snake maze on 24x24 m square arena."
    "48x48 logical grid at 0.5 m/cell."
  ]
  title "Pioneer 3-AT - Laberinto serpiente"
  lineScale 0.5
}

Viewpoint {
  orientation -0.360152 0.359539 0.860826 1.72179
  position 0 -22 20
  follow ""
  followSmoothness 0
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  floorSize 24 24
  floorTileSize 0.5 0.5
  floorAppearance SandyGround {
  }
  wallThickness 0.05
  wallHeight 0.2
  wallAppearance PBRAppearance {
    baseColor 0.35 0.35 0.35
    roughness 1
    metalness 0
  }
}

DEF START_MARKER Solid {
  translation -4.5 9.75 0.015
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 0.35 1.0
        roughness 0.5
        metalness 0
        emissiveColor 0.0 0.04 0.2
      }
      geometry Cylinder {
        radius 0.34
        height 0.03
        subdivision 32
      }
    }
  ]
  name "START_MARKER_S_-4.25_10.25"
}

DEF PIONEER_3AT Pioneer3at {
  translation -4.25 9.75 0
  rotation 0 0 1 -1.5708
  controller "pioneer_TFM"
  supervisor TRUE
  extensionSlot [
    SickLms291 {
      translation 0.136 0 0.35
