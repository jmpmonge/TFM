# Superficie azul: zona de coste (nombre COST_ZONE_<n> → coste n en la rejilla).
DEF COST_ZONE_2 Solid {
  translation 2.5 8.75 0.008
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.12 0.45 0.95
        roughness 0.35
        metalness 0
        transparency 0.3
      }
      geometry Box {
        size 12 2 0.01
      }
    }
  ]
  name "COST_ZONE_2"
}

