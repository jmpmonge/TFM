#VRML_SIM R2025a utf8

# ============================================================
#  Pioneer 3-AT - mapa 8x8 doble U para A* / ARA*
#  ------------------------------------------------------------
#  Objetivo:
#  - Prototipo pequeño para probar planificación A* / ARA*.
#  - Escenario con obstáculo cóncavo doble tipo U.
#  - Cada celda lógica mide 1 m x 1 m.
#  - Los muros ocupan una celda completa: 1 x 1 m.
#  - La altura de los muros es 0.5 m.
#
#  Sistema de coordenadas usado:
#  - x: columnas, de -3.5 a 3.5
#  - y: filas, de 3.5 a -3.5
#  - z: altura
#
#  Mapa lógico 8x8:
#
#      col: 1 2 3 4 5 6 7 8
#  row 1: S . . . . . . .
#  row 2: . X X X X X . .
#  row 3: . X . . . X . .
#  row 4: . X . X . X . .
#  row 5: . X . X G X . .
#  row 6: . X . X X X . .
#  row 7: . X . . . . . .
#  row 8: . . . . . . . .
#
#  Leyenda:
#  - S = salida / posición inicial del robot
#  - G = objetivo
#  - X = muro / obstáculo
#  - . = celda libre
# ============================================================

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/adept/pioneer3/protos/Pioneer3at.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/sick/protos/SickLms291.proto"

WorldInfo {
  info [
    "Pioneer 3-AT route-planning world."
    "20x20, cada dcelda de 0.2 m"
  ]
  title "Pioneer 3-AT - ARA* 20x20"
  lineScale 0.5
}

# Vista para ver el grid completo.
Viewpoint {
  # Vista oblicua superior.
  orientation -0.360152 0.359539 0.860826 1.72179
  position 0 -12 11
  follow ""
  followSmoothness 0

  # Vista cenital:
  # orientation 0 1 0 1.5708
  # position 0 0 12
}

TexturedBackground {
}

TexturedBackgroundLight {
}

# ============================================================
# Arena
# ------------------------------------------------------------
# El mapa lógico mide 20 x 20 m.
# La arena también mide 20 x 20 m.
# ============================================================

RectangleArena {
  floorSize 20 20
  floorTileSize 1 1
  floorAppearance SandyGround {
  }
  wallThickness 0.05
  wallHeight 0.2
  wallAppearance PBRAppearance {
    baseColor 0.35 0.35 0.35
    roughness 1
    metalness 0
  }
}

# ============================================================
# Marcadores de inicio y objetivo
# ============================================================

# Marcador visual del inicio: S = fila 1, columna 1 = (-3.5, 3.5).
DEF START_MARKER Solid {
  translation -3.5 3.5 0.015
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 0.35 1.0
        roughness 0.5
        metalness 0
        emissiveColor 0.0 0.04 0.2
      }
      geometry Cylinder {
        radius 0.32
        height 0.03
        subdivision 32
      }
    }
  ]
  name "START_MARKER_S_-3.5_3.5"
}

# Marcador visual del objetivo: G = fila 5, columna 5 = (0.5, -0.5).
DEF GOAL_MARKER Solid {
  translation 0.5 -0.5 0.02
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.0 0.0
        roughness 0.5
        metalness 0
        emissiveColor 0.2 0.0 0.0
      }
      geometry Cylinder {
        radius 0.34
        height 0.04
        subdivision 32
      }
    }
  ]
  name "GOAL_MARKER_G_0.5_-0.5"
}

# Esfera roja para que el objetivo sea visible en 3D.
# El extractor debe usar GOAL_ARA como objetivo real.
DEF GOAL_ARA Solid {
  translation 0.5 -0.5 0.55
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.0 0.0
        roughness 0.4
        metalness 0
        emissiveColor 0.3 0.0 0.0
      }
      geometry DEF GOAL_GEOM Sphere {
        radius 0.18
        subdivision 3
      }
    }
  ]
  name "GOAL_ARA"
  boundingObject USE GOAL_GEOM
}

# ============================================================
# Muros rectangulares del mapa
# ------------------------------------------------------------
# En lugar de un muro por celda, se agrupan celdas consecutivas.
# ============================================================

DEF WALL_TOP Solid {
  translation -0.5 2.5 0.25
  children [
    Shape {
      appearance DEF WALL_APP PBRAppearance {
        baseColor 0.03 0.03 0.03
        roughness 1
        metalness 0
      }
      geometry Box {
        size 5 1 0.5
      }
    }
  ]
  name "WALL_TOP_RECT"
  boundingObject Box {
    size 5 1 0.5
  }
}

DEF WALL_LEFT Solid {
  translation -2.5 -0.5 0.25
  children [
    Shape {
      appearance USE WALL_APP
      geometry Box {
        size 1 5 0.5
      }
    }
  ]
  name "WALL_LEFT_RECT"
  boundingObject Box {
    size 1 5 0.5
  }
}

DEF WALL_RIGHT Solid {
  translation 1.5 0.0 0.25
  children [
    Shape {
      appearance USE WALL_APP
      geometry Box {
        size 1 4 0.5
      }
    }
  ]
  name "WALL_RIGHT_RECT"
  boundingObject Box {
    size 1 4 0.5
  }
}

DEF WALL_INNER_VERTICAL Solid {
  translation -0.5 -0.5 0.25
  children [
    Shape {
      appearance USE WALL_APP
      geometry Box {
        size 1 3 0.5
      }
    }
  ]
  name "WALL_INNER_VERTICAL_RECT"
  boundingObject Box {
    size 1 3 0.5
  }
}

DEF WALL_INNER_BOTTOM Solid {
  translation 0.5 -1.5 0.25
  children [
    Shape {
      appearance USE WALL_APP
      geometry Box {
        size 1 1 0.5
      }
    }
  ]
  name "WALL_INNER_BOTTOM_RECT"
  boundingObject Box {
    size 1 1 0.5
  }
}

# ============================================================
# Robot Pioneer 3-AT
# ------------------------------------------------------------
# Posición inicial: S = fila 1, columna 1 = (-3.5, 3.5).
# La orientación apunta aproximadamente hacia el interior del mapa.
# ============================================================

DEF PIONEER_3AT Pioneer3at {
  translation -3.5 3.5 0
  rotation 0 0 1 -0.785398
  controller "pioneer_TFM"
  supervisor TRUE
  extensionSlot [
    SickLms291 {
      translation 0.136 0 0.35
    }
    GPS {
      name "gps"
    }
    InertialUnit {
      name "imu"
    }
    Display {
      name "display"
      width 140
      height 36
    }
  ]
}
