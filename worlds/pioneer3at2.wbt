    Shape {
      appearance DEF WALL_APP PBRAppearance {
        baseColor 0.03 0.03 0.03
        roughness 1
        metalness 0
      }
      geometry Box {
        size 25 1 0.5
      }
    }
  ]
  name "WALL_TOP_RECT"
  boundingObject Box {
    size 25 1 0.5
  }
}

