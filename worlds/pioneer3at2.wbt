#VRML_SIM R2025a utf8

# ============================================================
#  Pioneer 3-AT - laberinto rectangular para A* / ARA*
#  ------------------------------------------------------------
#  Objetivo:
#  - Escenario con pasillo único y muros rectangulares.
#  - Pensado para planificación A* / ARA*.
#  - Cada celda lógica mide 1 m x 1 m.
#  - Arena de 20 x 20 m.
#  - Mapa lógico 20x20.
#
#  Sistema de coordenadas:
#  - x: de -10 a 10
#  - y: de -10 a 10
#  - z: altura
#
#  Mapa lógico 20x20
# ============================================================

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/SandyGround.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/robots/adept/pioneer3/protos/Pioneer3at.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/devices/sick/protos/SickLms291.proto"

WorldInfo {
  info [
    "Pioneer 3-AT route-planning world."
    "20x20 logical grid map for A* and ARA* experiments."
    "Each logical cell is 1 x 1 m."
    "Maze built with rectangular walls and wide corridors."
  ]
  title "Pioneer 3-AT - ARA* 20x20 maze"
  lineScale 0.5
}

Viewpoint {
  orientation -0.360152 0.359539 0.860826 1.72179
  position 0 -24 22
  follow ""
  followSmoothness 0

  # Vista cenital alternativa:
  # orientation 0 1 0 1.5708
  # position 0 0 24
}

TexturedBackground {
}

TexturedBackgroundLight {
}

# ============================================================
# Arena
# ============================================================

RectangleArena {
  floorSize 20 20
  floorTileSize 1 1
  floorAppearance SandyGround {
  }
  wallThickness 0.05
  wallHeight 0.2
  wallAppearance PBRAppearance {
    baseColor 0.35 0.35 0.35
    roughness 1
    metalness 0
  }
}

# ============================================================
# Marcadores de inicio y objetivo
# ============================================================

DEF START_MARKER Solid {
  translation -8.5 8.5 0.015
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 0.35 1.0
        roughness 0.5
      }
      geometry Cylinder {
        radius 0.32
        height 0.03
      }
    }
  ]
  name "START_MARKER"
}

DEF GOAL_ARA Solid {
  translation -5.5 6.3 0.55
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1.0 0.0 0.0
        roughness 0.4
      }
      geometry Sphere {
        radius 0.18
      }
    }
  ]
  name "GOAL_ARA"
}

# ============================================================
# Apariencia común de los muros
# ============================================================

DEF WALL_APP PBRAppearance {
  baseColor 0.03 0.03 0.03
  roughness 1
  metalness 0
}

# ============================================================
# Muros rectangulares del laberinto
# ------------------------------------------------------------
# Cada WALL_X es un Solid con geometry Box y boundingObject Box.
# El extractor reconocerá estos nodos porque empiezan por DEF WALL_.
# ============================================================

# ============================================================
# MUROS DEL LABERINTO
# ============================================================

DEF WALL_1 Solid {
  translation -1.0 7.0 0.25
  children [
    Shape {
      appearance USE WALL_APP
      geometry Box { size 11.5 0.35 0.5 }
    }
  ]
  name "WALL_1_SUPERIOR"
  boundingObject Box { size 11.5 0.35 0.5 }
}

DEF WALL_2 Solid {
  translation -6.8 6.2 0.25
  children [
    Shape {
