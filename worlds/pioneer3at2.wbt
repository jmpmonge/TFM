DEF PIONEER_3AT Pioneer3at {
  translation -17.51 17.51 0
  rotation 0 0 1 -0.785398
  controller "pioneer_TFM"
  supervisor TRUE
  extensionSlot [
    SickLms291 {
      translation 0.136 0 0.35
